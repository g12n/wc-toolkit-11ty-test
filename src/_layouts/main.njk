<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} </title>
    <style>
        :root{
            --content-width: 78ch;
            --body-padding: max(1rem, calc((100vw - var(--content-width)) /2 ))
        }
        body{

            padding-inline: var( --body-padding);
        }
    </style>
</head>
